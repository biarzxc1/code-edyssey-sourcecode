<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#170E2D"
    app:cardCornerRadius="24dp"
    app:strokeColor="#A855F7"
    app:strokeWidth="1.8dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHALLENGE DIFFICULTY"
            android:textColor="#5EEAD4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Difficulty Mode"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- EASY CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPromptEasy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#22123C"
            app:strokeColor="#5EEAD4"
            app:strokeWidth="1.5dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvPromptEasyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EASY"
                    android:textColor="#5EEAD4"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvPromptEasyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNLOCKED"
                    android:textColor="#5EEAD4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MEDIUM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPromptMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#22123C"
            app:strokeColor="#C084FC"
            app:strokeWidth="1.5dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPromptMediumTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MEDIUM"
                        android:textColor="#C084FC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvPromptMediumStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 LOCKED"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPromptMediumLockHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear / Perfect Easy quiz to unlock"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- HARD CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPromptHard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#22123C"
            app:strokeColor="#F59E0B"
            app:strokeWidth="1.5dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPromptHardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HARD"
                        android:textColor="#FBBF24"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvPromptHardStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 LOCKED"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPromptHardLockHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear / Perfect Medium quiz to unlock"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cancel button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPromptCancel"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="CANCEL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            app:backgroundTint="#00000000"
            app:strokeColor="#475569"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
